# ============================================================
# DOCUMIND AI — CONFIGURACIÓN DE VARIABLES DE ENTORNO
# Plantilla oficial de referencia (NUNCA subas claves reales a Git)
# ============================================================

# 1. Entorno y Servidor
NODE_ENV=development
PORT=3000

# 2. URLs y Orígenes Permitidos (CORS)
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=*

# 3. Motor Cognitivo Google Gemini (Backend Privado — NUNCA exponer en Frontend)
# Obtén tu API Key en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_MODEL=gemini-2.5-flash

# 4. Supabase Auth & PostgreSQL (Persistencia y Row Level Security)
# Obtén las claves en: https://supabase.com/dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
# Clave privada de administración (SOLO BACKEND, nunca enviar al cliente):
SUPABASE_SERVICE_ROLE_KEY=

# 5. Credenciales OAuth (Configurar en Supabase Auth -> Providers -> Google y GitHub)
# Proveedor 1: Google OAuth 2.0 (Ya configurado en Supabase Auth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Proveedor 2: GitHub OAuth App (Configurar en GitHub Developer Settings -> OAuth Apps y en Supabase Auth -> Providers -> GitHub)
# Callback URL en GitHub OAuth App: https://<TU_PROYECTO>.supabase.co/auth/v1/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Token opcional de servidor para aumentar límite de tasa de GitHub REST API v3 en análisis de repositorios:
GITHUB_TOKEN=

# 6. Seguridad de Sesión y Cifrado
SESSION_SECRET=
ENCRYPTION_KEY=

# 7. Modo de Operación
DEMO_MODE=false
