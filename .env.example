# ============================================================
# DOCUMENT-MIND AI — CONFIGURACIÓN DE ENTORNO
# ============================================================

# Puerto del servidor backend Express (por defecto: 3000)
PORT=3000

# Entorno de ejecución: development | production
NODE_ENV=development

# Clave de API de Google Gemini (requerida para síntesis generativa y chat)
# Obtén tu clave gratuita en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_clave_aqui_sin_comillas

# Modelo de Google Gemini (recomendado: gemini-2.5-flash)
AI_MODEL=gemini-2.5-flash

# Token opcional de GitHub para repositorios públicos con alta tasa de solicitudes
# (No obligatorio para uso estándar)
GITHUB_TOKEN=
